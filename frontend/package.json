{
  "name": "base-ai-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "vue-tsc --noEmit -p jsconfig.json",
    "test:coverage": "node --experimental-test-coverage --test --test-coverage-include='src/utils/**/*.js' --test-coverage-lines=95 --test-coverage-branches=75 --test-coverage-functions=90 test/*.test.mjs tests/*.test.js",
    "test:e2e": "npm run build && node --test e2e/*.test.mjs",
    "test": "npm run lint && npm run typecheck && npm run test:coverage && npm run test:e2e"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "axios": "^1.20.0",
    "element-plus": "^2.14.5",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "typescript": "^7.0.2",
    "vue-tsc": "^3.3.11",
    "vite": "^8.2.2"
  }
}
