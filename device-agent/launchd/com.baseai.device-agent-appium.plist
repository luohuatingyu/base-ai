<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.baseai.device-agent-appium</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BIN__</string>
    <string>__APPIUM_BIN__</string>
    <string>--address</string><string>127.0.0.1</string>
    <string>--port</string><string>4723</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__NODE_PATH__:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>APPIUM_HOME</key><string>__APPIUM_HOME__</string>
    <key>HOME</key><string>__USER_HOME__</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__AGENT_LOG__/appium.log</string>
  <key>StandardErrorPath</key><string>__AGENT_LOG__/appium-error.log</string>
</dict>
</plist>
