<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.baseai.device-agent-registry</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REGISTRY_PYTHON__</string>
    <string>-m</string><string>device_agent.registry</string>
    <string>--serve</string>
    <string>--authorized-uid</string><string>__AUTHORIZED_UID__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key><string>__REGISTRY_ROOT__/app</string>
    <key>PATH</key><string>__REGISTRY_ROOT__/runtime/node/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>__REGISTRY_ROOT__</string>
    <key>APPIUM_HOME</key><string>__REGISTRY_ROOT__/appium-home</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__REGISTRY_ROOT__/logs/helper.log</string>
  <key>StandardErrorPath</key><string>__REGISTRY_ROOT__/logs/helper-error.log</string>
</dict>
</plist>
