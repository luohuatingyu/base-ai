{
	{$CADDY_ADMIN_OPTION}
	skip_install_trust
	auto_https disable_redirects
	{$CADDY_DEFAULT_SNI_OPTION}
	pki {
		ca local {
			intermediate_lifetime 397d
		}
	}
}

:80 {
	@localHealth {
		host 127.0.0.1 localhost
		path /health
	}
	handle @localHealth {
		respond "OK" 200
	}

	@allowedHost host {$CADDY_ALLOWED_HOSTS}
	handle @allowedHost {
		redir https://{host}{$CADDY_HTTPS_PORT_SUFFIX}{uri} 308
	}

	handle {
		{$CADDY_HTTP_FALLBACK}
	}
}

{$CADDY_HTTPS_SITE_ADDRESSES} {
	{$CADDY_TLS_DIRECTIVE}

	encode zstd gzip
	request_body {
		max_size {$APP_MAX_REQUEST_BYTES:20971520}
	}

	header {
		-Server
		{$CADDY_HSTS_HEADER}
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
	}

	@internal path /api/internal /api/internal/*
	handle @internal {
		respond "Not Found" 404
	}

	@api path /api/*
	handle @api {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:8080
	}
}
