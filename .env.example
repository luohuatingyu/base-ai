# ---------- MySQL: system database ----------
MYSQL_URL=jdbc:mysql://mysql.example.com:3306/base_ai_system?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&sslMode=VERIFY_IDENTITY
MYSQL_USERNAME=base_ai_system
MYSQL_PASSWORD=change-me
MYSQL_POOL_SIZE=20

# ---------- OSS media backup (only the public/ prefix is used) ----------
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=xyzc
OSS_PREFIX=public/
# 生产环境建议改用只具备 DDL/Flyway 权限的独立账号；留空时复用运行账号
MYSQL_MIGRATION_URL=
MYSQL_MIGRATION_USERNAME=
MYSQL_MIGRATION_PASSWORD=

# ---------- PostgreSQL: optional subordinate business database ----------
POSTGRES_ENABLED=false
POSTGRES_URL=jdbc:postgresql://postgres.example.com:5432/base_ai_business?currentSchema=public&sslmode=verify-full
POSTGRES_USERNAME=base_ai_business
POSTGRES_PASSWORD=change-me
POSTGRES_POOL_SIZE=10
DATABASE_CONNECTION_TIMEOUT_MS=5000

# ---------- Redis: cache database ----------
REDIS_HOST=redis.example.com
REDIS_PORT=6379
REDIS_USERNAME=base_ai
REDIS_PASSWORD=change-me
REDIS_DATABASE=0
REDIS_TIMEOUT=5s
REDIS_SSL=true

# ---------- Platform configuration and authentication ----------
APP_PLATFORM_CODE=ai-platform
APP_PLATFORM_NAME_EN=AI Platform
APP_PLATFORM_NAME_ZH=AI平台
# Docker Compose 会将平台简称规范为小写项目与容器前缀，例如 AI 对应 ai-frontend
APP_PLATFORM_SHORT_NAME=AI
# 使用完整 Git Commit 作为全部自建镜像标签和 OCI revision；例如 git rev-parse HEAD
APP_IMAGE_REVISION=
# 后端无 Accept-Language 请求头时的默认语言，仅支持 en-US 或 zh-CN
APP_DEFAULT_LOCALE=en-US
APP_TOKEN_SECRET=replace-with-at-least-32-random-characters
APP_TOKEN_EXPIRE_MINUTES=720
APP_SEED_ADMIN_USERNAME=admin
# 可留空；首次启动会生成强随机密码并保存到受限 bootstrap-secrets 卷
APP_SEED_ADMIN_PASSWORD=
# 默认不覆盖已有管理员密码；仅在明确需要环境变量持续同步密码时开启
APP_SEED_ADMIN_PASSWORD_SYNC_ENABLED=false
APP_CONFIG_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# 轮换时追加 key-id=Base64Key，保留旧 APP_CONFIG_ENCRYPTION_KEY 直到数据完成重加密
APP_CONFIG_ENCRYPTION_KEYS=
APP_CONFIG_ENCRYPTION_ACTIVE_KEY_ID=legacy
# 设备 Agent 使用管理页面生成的一次性配对码，独立凭据加密保存在 MySQL
DEVICE_AGENT_NONCE_TTL_SECONDS=600
DEVICE_AGENT_SIGNATURE_CLOCK_SKEW_SECONDS=300
DEVICE_AGENT_HEARTBEAT_STALE_SECONDS=180
DEVICE_AGENT_PAIRING_TTL_SECONDS=900
DEVICE_AGENT_REGISTRY_DEFAULT_PORT=42314
AGENT_NODE_VERSION=22.22.0
AGENT_NODE_BASE_URL=https://nodejs.org/dist
AGENT_APPIUM_SPEC=appium@3.7.0
AGENT_XCUITEST_SPEC=xcuitest@12.11.1
# 可选；留空时复用 APP_CONFIG_ENCRYPTION_KEY，生产建议使用独立的至少 32 位随机密钥
APP_API_KEY_HASH_SECRET=
# 仅填写额外反向代理所在网段；留空时信任 Compose 应用网络中的 Frontend
APP_TRUSTED_PROXY_CIDRS=
APP_LOGIN_ACCOUNT_IP_FAILURES=5
APP_LOGIN_IP_FAILURES=20
APP_LOGIN_WINDOW_MINUTES=5
APP_LOGIN_BLOCK_MINUTES=15
APP_SECRET_REVEAL_FAILURES=5
APP_SECRET_REVEAL_WINDOW_MINUTES=5
APP_SECRET_REVEAL_BLOCK_MINUTES=15
# 同源部署保持为空；多个精确 Origin 使用逗号分隔，禁止通配符
APP_CORS_ALLOWED_ORIGINS=
APP_PASSWORD_MIN_LENGTH=12
APP_MAX_REQUEST_BYTES=67108864
# Anonymous login requests use a lower cap than authenticated business APIs.
APP_AUTH_REQUEST_MAX_BYTES=65536
APP_MAX_REQUEST_HEADER_SIZE=16KB

# Knowledge-base uploads: 10 MiB file, with one MiB reserved for multipart metadata.
KNOWLEDGE_UPLOAD_MAX_BYTES=10485760
KNOWLEDGE_UPLOAD_REQUEST_MAX_BYTES=11534336

# ---------- Internal service authentication ----------
PYTHON_WORKER_URL=http://python-worker:8000
PYTHON_WORKER_INTERNAL_TOKEN=replace-with-a-random-internal-token
PYTHON_WORKER_INSTANCE_ID=python-worker-1
JAVA_INSTANCE_ID=java-backend-1

# ---------- Isolated document parser ----------
DOCUMENT_PARSER_MAX_BYTES=10485760
DOCUMENT_PARSER_MAX_CHARACTERS=2000000
DOCUMENT_PARSER_TIMEOUT_SECONDS=20
DOCUMENT_PARSER_CONCURRENCY=2
DOCUMENT_PARSER_MEMORY_LIMIT=384m
DOCUMENT_PARSER_CPU_LIMIT=1.0
DOCUMENT_PARSER_PIDS_LIMIT=64

# ---------- Runtime container resource limits ----------
BACKEND_MEMORY_LIMIT=2g
BACKEND_CPU_LIMIT=2.0
BACKEND_PIDS_LIMIT=512
PYTHON_WORKER_MEMORY_LIMIT=1g
PYTHON_WORKER_CPU_LIMIT=2.0
PYTHON_WORKER_PIDS_LIMIT=256
FRONTEND_MEMORY_LIMIT=256m
FRONTEND_CPU_LIMIT=1.0
FRONTEND_PIDS_LIMIT=128

# ---------- Runtime YAML configuration ----------
TRACE_TRACKING_EXCLUSIONS_FILE=/etc/base-ai/trace-tracking-exclusions.yml
LLM_TIMEOUT_SECONDS=60
LLM_LOG_CONTENT=false
WORKER_MAX_REQUEST_BYTES=67108864
LLM_RESPONSE_MAX_BYTES=10485760
# 模型路由自动同步默认开启；服务启动时同步一次，后续按间隔执行
LLM_ROUTE_HEALTH_CHECK_ENABLED=true
# 模型路由自动同步间隔，单位毫秒，默认 1 小时
LLM_ROUTE_HEALTH_CHECK_INTERVAL_MS=3600000

# ---------- Automation API trigger ----------
API_TRIGGER_SCHEDULER_POOL_SIZE=4
API_TRIGGER_LOCK_SECONDS=300
API_TRIGGER_RESULT_MAX_LENGTH=2000
API_TRIGGER_RESPONSE_MAX_BYTES=2097152
API_TRIGGER_REQUEST_BODY_MAX_BYTES=1048576
API_TRIGGER_METADATA_MAX_LENGTH=65536
WORKFLOW_EXECUTOR_POOL_SIZE=4
WORKFLOW_EXECUTOR_QUEUE_CAPACITY=400
WORKFLOW_MAX_NODES=100
WORKFLOW_MAX_ITERATIONS=100
WORKFLOW_MAX_AGENT_STEPS=20
WORKFLOW_MAX_RECURSION_DEPTH=5
WORKFLOW_MAX_PAYLOAD_BYTES=1048576
WORKFLOW_MAX_WAIT_SECONDS=3600
WORKFLOW_MAX_EXECUTION_STEPS=1000
WORKFLOW_MAX_RUN_DURATION_SECONDS=86400
WORKFLOW_MAX_RUN_LOG_BYTES=10485760
WORKFLOW_LEASE_SECONDS=60
WORKFLOW_WEBHOOK_MAX_BODY_BYTES=1048576
WORKFLOW_WEBHOOK_RATE_LIMIT_PER_MINUTE=60
WORKFLOW_TRIGGER_DELIVERY_RETENTION_DAYS=30
WORKFLOW_RUN_RETENTION_DAYS=30

# ---------- Unified task logging ----------
LOG_LEVEL=INFO
LOG_CONSOLE_QUEUE_CAPACITY=8192
TRACE_LOG_PERSIST_LEVEL=INFO
TRACE_LOG_QUEUE_CAPACITY=10000
TRACE_LOG_BATCH_SIZE=100
TRACE_LOG_FLUSH_INTERVAL_MS=500
TRACE_LOG_RETENTION_DAYS=7
# 操作审计日志只保留操作元数据；历史请求快照会由迁移永久清空。
AUDIT_OPERATION_LOG_RETENTION_DAYS=90
TRACE_HEARTBEAT_TIMEOUT_SECONDS=120
CONTAINER_LOG_MAX_SIZE=20m
CONTAINER_LOG_MAX_FILES=5

# ---------- HTTP ingress and application ports ----------
# Frontend 直接提供 HTTP 入口；如需 HTTPS，请在项目外部的反向代理终止 TLS。
APP_SESSION_COOKIE_SECURE=false
# 宿主机 HTTP 入口端口
HTTP_PORT=80
# 内部网络高级配置
APP_NETWORK_SUBNET=172.30.0.0/24
# 前端服务端代理使用的 Docker 内部后端地址，通常无需修改
FRONTEND_BACKEND_URL=http://backend:8080

# ---------- Optional package mirrors ----------
# Frontend 可分发的 macOS Python 3.12 自包含运行时；设为 false 仅用于离线构建排障
AGENT_RUNTIME_BUNDLE=true
AGENT_PYTHON_VERSION=3.12.8
AGENT_PYTHON_TAG=20250106
AGENT_PYTHON_BASE_URL=https://github.com/astral-sh/python-build-standalone/releases/download
# Deployment Agent 构建使用的 Go 模块代理；可按部署网络覆盖
GOPROXY=https://goproxy.cn,direct
# Frontend 运行镜像使用的 Alpine 软件源；不要添加末尾斜杠
ALPINE_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/alpine
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_TRUSTED_HOST=mirrors.aliyun.com
NPM_CONFIG_REGISTRY=https://registry.npmjs.org
# 留空则不加速；需要时可填如 https://maven.aliyun.com/repository/public
MAVEN_MIRROR_URL=
