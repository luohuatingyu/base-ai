# ---------- MySQL: system database ----------
MYSQL_URL=jdbc:mysql://mysql.example.com:3306/base_ai_system?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USERNAME=base_ai_system
MYSQL_PASSWORD=change-me

# ---------- PostgreSQL: subordinate business database ----------
POSTGRES_URL=jdbc:postgresql://postgres.example.com:5432/base_ai_business?currentSchema=public
POSTGRES_USERNAME=base_ai_business
POSTGRES_PASSWORD=change-me
POSTGRES_POOL_SIZE=10
DATABASE_CONNECTION_TIMEOUT_MS=5000

# ---------- Redis: cache database ----------
REDIS_HOST=redis.example.com
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DATABASE=0
REDIS_TIMEOUT=5s

# ---------- Platform configuration and authentication ----------
APP_PLATFORM_CODE=ai-platform
APP_PLATFORM_NAME_EN=AI Platform
APP_PLATFORM_NAME_ZH=AI平台
# Docker Compose 会将平台简称规范为小写项目与容器前缀，例如 AI 对应 ai-caddy
APP_PLATFORM_SHORT_NAME=AI
# 后端无 Accept-Language 请求头时的默认语言，仅支持 en-US 或 zh-CN
APP_DEFAULT_LOCALE=en-US
APP_TOKEN_SECRET=replace-with-at-least-32-random-characters
APP_TOKEN_EXPIRE_MINUTES=720
APP_SEED_ADMIN_USERNAME=admin
APP_SEED_ADMIN_PASSWORD=replace-before-first-start
# 默认不覆盖已有管理员密码；仅在明确需要环境变量持续同步密码时开启
APP_SEED_ADMIN_PASSWORD_SYNC_ENABLED=false
APP_CONFIG_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# 可选；留空时复用 APP_CONFIG_ENCRYPTION_KEY，生产建议使用独立的至少 32 位随机密钥
APP_API_KEY_HASH_SECRET=
# 仅填写实际反向代理所在网段；留空时 Compose 仅信任内部 Caddy
APP_TRUSTED_PROXY_CIDRS=
APP_LOGIN_ACCOUNT_IP_FAILURES=5
APP_LOGIN_IP_FAILURES=20
APP_LOGIN_WINDOW_MINUTES=5
APP_LOGIN_BLOCK_MINUTES=15
APP_PASSWORD_MIN_LENGTH=12
APP_MAX_REQUEST_BYTES=20971520
APP_MAX_REQUEST_HEADER_SIZE=16KB

# ---------- Internal service authentication ----------
PYTHON_WORKER_URL=http://python-worker:8000
PYTHON_WORKER_INTERNAL_TOKEN=replace-with-a-random-internal-token
# 插件 Worker 使用独立令牌，不得复用登录、API Key 或模型密钥
PLUGIN_WORKER_INTERNAL_TOKEN=replace-with-a-different-random-internal-token
DIFY_PLUGIN_WORKER_URL=http://dify-plugin-worker:8101
N8N_PLUGIN_WORKER_URL=http://n8n-plugin-worker:8102
WORKFLOW_PLUGIN_WORKER_TIMEOUT_SECONDS=240

# ---------- Runtime YAML configuration ----------
TRACE_TRACKING_EXCLUSIONS_FILE=/etc/base-ai/trace-tracking-exclusions.yml
LLM_TIMEOUT_SECONDS=60
LLM_LOG_CONTENT=true
WORKER_MAX_REQUEST_BYTES=20971520
LLM_RESPONSE_MAX_BYTES=10485760
# 模型路由自动同步默认开启；服务启动时同步一次，后续按间隔执行
LLM_ROUTE_HEALTH_CHECK_ENABLED=true
# 模型路由自动同步间隔，单位毫秒，默认 1 小时
LLM_ROUTE_HEALTH_CHECK_INTERVAL_MS=3600000

# ---------- Automation API trigger ----------
API_TRIGGER_SCHEDULER_POOL_SIZE=4
API_TRIGGER_LOCK_SECONDS=300
API_TRIGGER_RESULT_MAX_LENGTH=2000
API_TRIGGER_RESPONSE_MAX_BYTES=2097152
API_TRIGGER_REQUEST_BODY_MAX_BYTES=1048576
API_TRIGGER_METADATA_MAX_LENGTH=65536
WORKFLOW_EXECUTOR_POOL_SIZE=4
WORKFLOW_EXECUTOR_QUEUE_CAPACITY=400
WORKFLOW_MAX_NODES=100
WORKFLOW_MAX_ITERATIONS=100
WORKFLOW_MAX_AGENT_STEPS=20
WORKFLOW_MAX_RECURSION_DEPTH=5
WORKFLOW_MAX_PAYLOAD_BYTES=1048576
WORKFLOW_MAX_WAIT_SECONDS=3600
WORKFLOW_MAX_EXECUTION_STEPS=1000
WORKFLOW_MAX_RUN_LOG_BYTES=10485760
WORKFLOW_LEASE_SECONDS=60
WORKFLOW_WEBHOOK_MAX_BODY_BYTES=1048576
WORKFLOW_WEBHOOK_RATE_LIMIT_PER_MINUTE=60
WORKFLOW_TRIGGER_DELIVERY_RETENTION_DAYS=30
WORKFLOW_MARKETPLACE_N8N_URL=https://n8n.io
WORKFLOW_MARKETPLACE_N8N_API_URL=https://api.n8n.io
WORKFLOW_MARKETPLACE_NPM_REGISTRY_URL=https://registry.npmjs.org
WORKFLOW_MARKETPLACE_DIFY_URL=https://marketplace.dify.ai
WORKFLOW_MARKETPLACE_PROBE_CONCURRENCY=4
WORKFLOW_MARKETPLACE_PROBE_QUEUE_CAPACITY=100
WORKFLOW_MARKETPLACE_PROBE_MAX_ATTEMPTS=3
WORKFLOW_MARKETPLACE_PROBE_RETENTION_HOURS=168
WORKFLOW_MARKETPLACE_TIMEOUT_SECONDS=8
WORKFLOW_MARKETPLACE_CACHE_SECONDS=300
WORKFLOW_MARKETPLACE_MAX_PACKAGE_BYTES=5242880
WORKFLOW_MARKETPLACE_MAX_UNPACKED_BYTES=10485760
WORKFLOW_MARKETPLACE_MAX_PACKAGE_FILES=128
PLUGIN_WORKER_MAX_REQUEST_BYTES=15728640
PLUGIN_INVOCATION_TIMEOUT_SECONDS=60
PLUGIN_DEPENDENCY_INSTALL_TIMEOUT_SECONDS=180
PLUGIN_PROBE_TIMEOUT_SECONDS=20
PLUGIN_WORKER_PIDS_LIMIT=128
PLUGIN_WORKER_MEMORY_LIMIT=512m
PLUGIN_WORKER_CPU_LIMIT=1.0
DIFY_PLUGIN_WORKER_MEMORY_LIMIT=1g
DIFY_PLUGIN_WORKER_CPU_LIMIT=2.0
PLUGIN_PIP_CACHE_DIR=/data/packages/.pip-cache

# ---------- Unified task logging ----------
TRACE_LOG_PERSIST_LEVEL=INFO
TRACE_LOG_QUEUE_CAPACITY=10000
TRACE_LOG_BATCH_SIZE=100
TRACE_LOG_FLUSH_INTERVAL_MS=500
TRACE_LOG_RETENTION_DAYS=7
TRACE_HEARTBEAT_TIMEOUT_SECONDS=120

# ---------- HTTPS ingress and application ports ----------
# YAML HTTPS 站点清单与 TLS 证书根目录必须同时配置，并可与预配置及动态学习 IP 同时使用
APP_HTTPS_SITES_FILE=
TLS_CERTS_DIR=
# 可选；逗号或空白分隔的规范 IPv4 会在启动时签发，首次可直接使用 HTTPS
APP_HTTPS_IPS=
# 新 IP 首次通过 HTTP 访问后自动签发；以下仅配置续期检查和资源保护，不配置任何 IP
TLS_CERT_CHECK_INTERVAL_SECONDS=3600
IP_CERT_MIN_ISSUE_INTERVAL_SECONDS=5
IP_CERT_MAX_LEARNED_HOSTS=32
# 应用会话仅应通过 HTTPS 访问，会话 Cookie 必须仅通过安全连接传输
APP_SESSION_COOKIE_SECURE=true
# 宿主机入口端口；改为 80/443 前需确认端口未被占用
HTTP_PORT=80
HTTPS_PORT=443
# 内部网络高级配置；Caddy IP 必须位于子网内且不得与其他容器冲突
CADDY_INTERNAL_IP=172.30.0.10
APP_NETWORK_SUBNET=172.30.0.0/24
# 前端服务端代理使用的 Docker 内部后端地址，通常无需修改
FRONTEND_BACKEND_URL=http://backend:8080

# ---------- Optional image and package mirrors ----------
MAVEN_IMAGE=maven:3.9.9-eclipse-temurin-17@sha256:f58d59b6273e785ac0a4477f6e9b5ba1d7731c75b906c0f7b34076f1851318cc
JRE_IMAGE=eclipse-temurin:17-jre@sha256:e4f018a55645ad204892e44eb35437518d7e108ba2a2dce305024ab371d24876
NODE_IMAGE=node:24-alpine@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43
CADDY_IMAGE=caddy:2.11.4-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648
PYTHON_IMAGE=python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de
# Caddy 构建使用的 Go 模块代理；可按部署网络覆盖
GOPROXY=https://goproxy.cn,direct
# Caddy 运行镜像使用的 Alpine 软件源；不要添加末尾斜杠
ALPINE_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/alpine
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_TRUSTED_HOST=mirrors.aliyun.com
# 留空则不加速；需要时可填如 https://maven.aliyun.com/repository/public
MAVEN_MIRROR_URL=
